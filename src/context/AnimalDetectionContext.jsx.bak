import React, { createContext, useState, useContext, useEffect } from 'react';
import { socket } from '../socket/socket';

const AnimalDetectionContext = createContext();

export const useAnimalDetection = () => {
  const context = useContext(AnimalDetectionContext);
  if (!context) {
    throw new Error('useAnimalDetection must be used within an AnimalDetectionProvider');
  }
  return context;
};

export const AnimalDetectionProvider = ({ children }) => {
  const [detectionData, setDetectionData] = useState({});
  const [processingVideos, setProcessingVideos] = useState(new Set());

  // Start detection for a video
  const startDetection = async (cameraId, videoName, animalType) => {
    try {
      const safeId = cameraId || `cam-${Date.now()}`;
      const safeAnimalType = animalType || 'Chicken';

      // Add to processing set
      setProcessingVideos(prev => new Set(prev).add(safeId));

      // Notify backend to start detection
      socket.emit('start_detection', {
        cameraId: safeId,
        videoName,
        animalType: safeAnimalType
      });

      return { success: true, cameraId: safeId };
    } catch (error) {
      console.error('Failed to start detection:', error);
      return { success: false, error: error.message };
    }
  };

  // Stop detection for a video
  const stopDetection = (cameraId) => {
    if (!cameraId) return;
    
    socket.emit('stop_detection', { cameraId });
    setProcessingVideos(prev => {
      const newSet = new Set(prev);
      newSet.delete(cameraId);
      return newSet;
    });

    // Clear detection data for this camera
    setDetectionData(prev => {
      const newData = { ...prev };
      delete newData[cameraId];
      return newData;
    });
  };

  useEffect(() => {
    // Listen for detection updates from backend
      ? { min: Math.max(0, baseCount.min - 2), max: Math.max(1, baseCount.max - 3) }
      : baseCount;
    
    // Generate random count within range
    const count = Math.floor(Math.random() * (countRange.max - countRange.min + 1)) + countRange.min;
  const startDetection = async (cameraId, frameData, animalType) => {
    try {
      // Ensure we have valid IDs
      const safeId = cameraId || `cam-${Date.now()}`;
      const safeAnimalType = animalType || 'Chicken';
      
      console.log(`Processing detection for camera ${safeId} with animal type ${safeAnimalType}`);
      
      // Add this camera to the processing set immediately
      setProcessingVideos(prev => {
        const newSet = new Set(prev);
        newSet.add(safeId);
        return newSet;
      });
      
      // Clear any existing interval for this camera
      if (detectionIntervalsRef.current[safeId]) {
        clearInterval(detectionIntervalsRef.current[safeId]);
      }
      
      // Generate initial detection data immediately
      const initialData = generateSimulatedDetectionData(safeId, safeAnimalType, true);
      
      // Update detection data right away
      setDetectionData(prev => ({
        ...prev,
        [safeId]: initialData
      }));
      
      // Set up faster interval (1 second) for more responsive updates
      detectionIntervalsRef.current[safeId] = setInterval(() => {
        // Generate new detection data with high-quality flag for QuickMonitoring
        const simulatedData = generateSimulatedDetectionData(safeId, safeAnimalType, true);
        
        // Update detection data
        setDetectionData(prev => ({
          ...prev,
          [safeId]: simulatedData
        }));
        
        // Record the last frame update time
        lastFrameUpdateRef.current[safeId] = Date.now();
      }, 1000); // Update every 1 second for more responsive UI
      
      // If we have frame data (blob), use it for better detection
      if (frameData instanceof Blob) {
        console.log(`Processing frame data (blob) for camera ${safeId}`);
        
        // In a real implementation, we would send this frame to the backend
        // For now, we'll simulate detection on this frame with higher quality
        const simulatedData = generateSimulatedDetectionData(safeId, safeAnimalType, true);
        
        // Update detection data with the frame-based detection
        setDetectionData(prev => ({
          ...prev,
          [safeId]: simulatedData
        }));
      } else if (typeof frameData === 'string') {
        // If we have a string (video name), use it to simulate detection
        console.log(`Processing video name for camera ${safeId}: ${frameData}`);
        
        // For QuickMonitoring, ensure we have high-quality detection
        if (frameData.includes('chick') || frameData.includes('farm')) {
          // Generate more detailed detection data for chicken videos
          const enhancedData = generateSimulatedDetectionData(safeId, 'Chicken', true);
          enhancedData.animals = enhancedData.animals.map(animal => ({
            ...animal,
            confidence: Math.min(0.95, animal.confidence + 0.15) // Boost confidence
          }));
          
          // Update detection data with enhanced detection
          setDetectionData(prev => ({
            ...prev,
            [safeId]: enhancedData
          }));
        }
      }
    } catch (error) {
      console.error('Error in detection process:', error);
      const safeId = cameraId || `cam-${Date.now()}`;
      setProcessingVideos(prev => {
        const newSet = new Set(prev);
        newSet.delete(safeId);
        return newSet;
      });
      throw error;
    }
  };

  const stopDetection = (cameraId) => {
    // Clear the detection interval for this camera
    if (detectionIntervalsRef.current[cameraId]) {
      clearInterval(detectionIntervalsRef.current[cameraId]);
      delete detectionIntervalsRef.current[cameraId];
    }
    
    setProcessingVideos(prev => {
      const newSet = new Set(prev);
      newSet.delete(cameraId);
      return newSet;
    });
    
    setDetectionData(prev => {
      const newData = { ...prev };
      delete newData[cameraId];
      return newData;
    });
    
    console.log('Stopped simulated detection for camera:', cameraId);
  };

  const detectionIntervalsRef = useRef({});
  const lastFrameUpdateRef = useRef({});

  const generateSimulatedDetectionData = (cameraId, animalType) => {
    // Time-of-day variations (less animals at night)
    const hour = new Date().getHours();
    const isNightTime = hour < 6 || hour > 20;
    
    // Base count depends on animal type
    const baseCount = {
      'Chicken': { min: 3, max: 8 },
      'Cow': { min: 1, max: 6 },
      'Pig': { min: 2, max: 6 },
      'Sheep': { min: 2, max: 7 },
      'Goat': { min: 2, max: 5 }
    }[animalType] || { min: 1, max: 4 };
    
    // Adjust count based on time of day
    const countRange = isNightTime 
      ? { min: Math.max(0, baseCount.min - 2), max: Math.max(1, baseCount.max - 3) }
      : baseCount;
    
    // Generate random count within range
    const count = Math.floor(Math.random() * (countRange.max - countRange.min + 1)) + countRange.min;
    
    // Randomly determine threat state
    const threatStates = ['Normal', 'Normal', 'Normal', 'Normal', 'Caution', 'Alert'];
    const threatState = threatStates[Math.floor(Math.random() * threatStates.length)];
    
    // Generate simulated bounding boxes for detected animals
    const detections = [];
    for (let i = 0; i < count; i++) {
      // Generate random position and size for the bounding box
      const x = Math.floor(Math.random() * 70); // Random x position (0-70%)
      const y = Math.floor(Math.random() * 70); // Random y position (0-70%)
      const width = 10 + Math.floor(Math.random() * 20); // Width between 10-30%
      const height = 10 + Math.floor(Math.random() * 20); // Height between 10-30%
      const confidence = 0.7 + (Math.random() * 0.3); // Confidence between 70-100%
      
      detections.push({
        bbox: [x, y, width, height],
        confidence: confidence,
        class: animalType || 'Animal',
        id: i,
        health: Math.random() > 0.8 ? 'sick' : 'healthy'
      });
    }
    
    return {
      cameraId,
      threatState,
      animalCount: count,
      lastUpdate: new Date(),
      detections: detections
    };
  };

  useEffect(() => {
    // Listen for detection updates from backend
    socket.on('detection_update', (data) => {
      if (data && data.cameraId) {
        setDetectionData(prev => ({
          ...prev,
          [data.cameraId]: {
            ...data,
            lastUpdate: new Date()
          }
        }));
      }
    });

    return () => {
      socket.off('detection_update');
    };
  }, []);

  return (
    <AnimalDetectionContext.Provider
      value={{
        detectionData,
        processingVideos: Array.from(processingVideos),
        startDetection,
        stopDetection
      }}
    >
      {children}
    </AnimalDetectionContext.Provider>
  );
};
